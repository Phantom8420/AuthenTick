NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Leave empty to use the in-memory store (data is lost on restart).
MONGODB_URI=

# Wallet sign-in for writes. Defaults to on in production, off otherwise.
# AUTH_REQUIRED=true
# Required in production when AUTH_REQUIRED is on. Use 32+ random characters.
# JWT_SECRET=
# Comma separated wallet addresses that get the ADMIN role and can grant others.
# ADMIN_ADDRESSES=0x...

# Optional: read ownership from the NFT contract instead of the database.
RPC_URL=
NFT_CONTRACT_ADDRESS=

# Optional: mirror writes onto the chain. The relayer wallet needs the manufacturer,
# distributor and retailer roles. Never reuse a key that holds real funds.
# REGISTRY_CONTRACT_ADDRESS=0x...
# RELAYER_PRIVATE_KEY=0x...

# "none" only if the web app and API are on different sites (HTTPS required).
# COOKIE_SAMESITE=lax
