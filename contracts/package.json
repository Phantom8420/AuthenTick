  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.1",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.3",
    "@openzeppelin/contracts": "^5.2.0",
    "@types/node": "^22.19.17",
    "hardhat": "^3.3.0",
    "typescript": "~5.8.2",
    "viem": "^2.47.10"
  }
}
