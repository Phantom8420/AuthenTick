{
  "name": "@authentick/contracts",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "AuthenTick smart contracts",
  "scripts": {
    "build": "hardhat compile",
    "clean": "hardhat clean",
