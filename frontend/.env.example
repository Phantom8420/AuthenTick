# Dev: Vite proxies /api to backend (see vite.config.ts)
VITE_API_PROXY_TARGET=http://localhost:4000

# Optional: direct API base when not using proxy (e.g. production build behind same host)
# VITE_API_URL=https://api.example.com

# Deployed AuthenTickNFT (required for “Connect” / contract calls from the browser)
# VITE_NFT_CONTRACT_ADDRESS=0x...
