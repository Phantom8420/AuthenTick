# GEMINI_API_KEY: Optional; used if you wire Gemini into the app.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL for links and callbacks.
APP_URL="MY_APP_URL"

# Firebase: copy config/firebase-applet-config.example.json to config/firebase-applet-config.json
# and fill in your Firebase web app values (see Firebase console).
